# OS / Editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Node & Build artifacts (for runtime or custom tools)
node_modules/
dist/
build/
*.log

# Sensitive credentials & environment keys (NEVER COMMIT)
*.key
*.pem
.credentials.yaml
.env
.env.*

# Local temporary files
tmp/
*.tmp


# Python cache
__pycache__/
*.pyc

# Real business documents / regulations imported locally
knowledge/regulations/*
!knowledge/regulations/README.md

# Personal original documents (require no desensitization but stay local-only)
knowledge/reflections/*
!knowledge/reflections/README.md
!knowledge/reflections/**/
knowledge/reflections/thoughts/*
!knowledge/reflections/thoughts/README.md
knowledge/reflections/speeches/*
!knowledge/reflections/speeches/README.md
knowledge/reflections/reports/*
!knowledge/reflections/reports/README.md
knowledge/reflections/news/*
!knowledge/reflections/news/README.md

# Learning materials (large public PDFs/PPTs, keep local)
knowledge/learning-materials/*
!knowledge/learning-materials/README.md

# Bootstrap 安装的锁定版本底座（由 scripts/bootstrap-runtime.sh 生成，勿提交）
runtime/dsh-runtime/

# CodeGraph 本地索引（每台机器各自生成，勿提交；配置见 codegraph.json）
.codegraph/

# 本地知识库抽取的纯文本缓存（由真实文档生成，含业务内容，只留本机）
.kb_extract/
